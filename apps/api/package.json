{
    "name": "@a3s-lab/api",
    "version": "1.0.0",
    "description": "Production-ready NestJS API with Domain-Driven Design and Clean Architecture",
    "author": "",
    "private": true,
    "license": "MIT",
    "scripts": {
        "build": "nest build",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "lint": "biome lint --write .",
        "lint:check": "biome lint .",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "test": "jest && jest --config ./test/jest-e2e.json",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json"
    },
    "dependencies": {
        "@a3s-lab/kysely": "workspace:*",
        "@a3s-lab/redisson": "workspace:*",
        "@a3s-lab/ddd": "workspace:*",
        "@a3s-lab/cqrs": "workspace:*",
        "@a3s-lab/http": "workspace:*",
        "@a3s-lab/observability": "workspace:*",
        "@a3s-lab/resilience": "workspace:*",
        "@a3s-lab/files": "workspace:*",
        "@nestjs/common": "^11.1.28",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.1.28",
        "@nestjs/cqrs": "^11.0.3",
        "@nestjs/platform-express": "^11.1.28",
        "@nestjs/swagger": "^11.4.6",
        "@nestjs/terminus": "^11.1.1",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.0",
        "kysely": "^0.28.14",
        "pg": "^8.18.0",
        "reflect-metadata": "^0.1.13",
        "rxjs": "^7.8.1",
        "uuid": "^11.1.1"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.24",
        "@nestjs/schematics": "^11.1.0",
        "@nestjs/testing": "^11.1.28",
        "@swc/cli": "^0.7.10",
        "@swc/core": "^1.15.11",
        "@types/express": "^5.0.6",
        "@types/jest": "^29.5.0",
        "@types/node": "^20.0.0",
        "@types/pg": "^8.16.0",
        "@types/supertest": "^7.2.1",
        "jest": "^29.5.0",
        "source-map-support": "^0.5.21",
        "supertest": "^7.2.2",
        "ts-jest": "^29.1.0",
        "ts-loader": "^9.4.3",
        "ts-node": "^10.9.1",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.1.3"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.ts$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node",
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/$1"
        }
    }
}
