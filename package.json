{
    "name": "@a3s-lab/nestify",
    "version": "1.0.0",
    "description": "Production-ready NestJS monorepo with pnpm workspace, Domain-Driven Design and Clean Architecture",
    "author": "",
    "private": true,
    "license": "MIT",
    "scripts": {
        "build": "pnpm -r build",
        "build:api": "pnpm --filter @a3s-lab/api build",
        "build:packages": "pnpm --filter \"./packages/**\" build",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "lint": "biome lint --write .",
        "lint:check": "biome lint .",
        "start": "pnpm --filter @a3s-lab/api start",
        "start:dev": "pnpm --filter @a3s-lab/api start:dev",
        "start:debug": "pnpm --filter @a3s-lab/api start:debug",
        "start:prod": "pnpm --filter @a3s-lab/api start:prod",
        "test": "pnpm -r test",
        "test:api": "pnpm --filter @a3s-lab/api test",
        "test:packages": "pnpm --filter \"./packages/**\" test",
        "test:kysely": "pnpm --filter @a3s-lab/kysely test",
        "test:redisson": "pnpm --filter @a3s-lab/redisson test",
        "test:cov": "pnpm -r test:cov",
        "clean": "pnpm -r clean && rm -rf node_modules",
        "build:core": "pnpm --filter @a3s-lab/ddd --filter @a3s-lab/cqrs --filter @a3s-lab/http --filter @a3s-lab/security --filter @a3s-lab/observability --filter @a3s-lab/resilience --filter @a3s-lab/kysely --filter @a3s-lab/redisson --filter @a3s-lab/clickhouse --filter @a3s-lab/migrations --filter @a3s-lab/files build",
        "test:core": "pnpm --filter @a3s-lab/ddd --filter @a3s-lab/cqrs --filter @a3s-lab/http --filter @a3s-lab/security --filter @a3s-lab/observability --filter @a3s-lab/resilience --filter @a3s-lab/kysely --filter @a3s-lab/redisson --filter @a3s-lab/clickhouse --filter @a3s-lab/migrations --filter @a3s-lab/files test",
        "pack:core": "rm -rf .artifacts/core-packages && mkdir -p .artifacts/core-packages && pnpm --filter @a3s-lab/ddd --filter @a3s-lab/cqrs --filter @a3s-lab/http --filter @a3s-lab/security --filter @a3s-lab/observability --filter @a3s-lab/resilience --filter @a3s-lab/kysely --filter @a3s-lab/redisson --filter @a3s-lab/clickhouse --filter @a3s-lab/migrations --filter @a3s-lab/files pack --pack-destination $PWD/.artifacts/core-packages",
        "verify:core-packages": "node scripts/verify-core-packages.mjs",
        "release:check": "pnpm format:check && pnpm lint:check && pnpm build:core && pnpm test:core && pnpm pack:core && pnpm verify:core-packages"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.3.14",
        "rimraf": "^6.0.1",
        "typescript": "^5.1.3"
    }
}
