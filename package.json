{
    "name": "@a3s-lab/nestify",
    "version": "1.0.0",
    "description": "DDD-focused NestJS backend API framework packages with a sample API workspace",
    "author": "",
    "private": true,
    "packageManager": "pnpm@10.30.3",
    "license": "MIT",
    "scripts": {
        "build": "pnpm -r build",
        "build:api": "pnpm --filter @a3s-lab/api build",
        "build:packages": "pnpm --filter \"./packages/**\" build",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "lint": "biome lint --write .",
        "lint:check": "biome lint .",
        "start": "pnpm --filter @a3s-lab/api start",
        "start:dev": "pnpm --filter @a3s-lab/api start:dev",
        "start:debug": "pnpm --filter @a3s-lab/api start:debug",
        "start:prod": "pnpm --filter @a3s-lab/api start:prod",
        "test": "pnpm -r test",
        "test:api": "pnpm --filter @a3s-lab/api test",
        "test:packages": "pnpm --filter \"./packages/**\" test",
        "test:kysely": "pnpm --filter @a3s-lab/kysely test",
        "test:redisson": "pnpm --filter @a3s-lab/redisson test",
        "test:cov": "pnpm -r test:cov",
        "clean": "pnpm -r clean && rm -rf node_modules",
        "build:core": "node scripts/run-core-packages.mjs build",
        "test:core": "node scripts/run-core-packages.mjs test",
        "pack:core": "node scripts/run-core-packages.mjs pack",
        "verify:core-packages": "node scripts/verify-core-packages.mjs",
        "changeset": "changeset",
        "version-packages": "changeset version",
        "publish:core:dry-run": "node scripts/publish-core-dry-run.mjs",
        "release:check": "pnpm format:check && pnpm lint:check && pnpm build:core && pnpm test:core && pnpm pack:core && pnpm verify:core-packages",
        "release:publish:dry-run": "pnpm release:check && pnpm publish:core:dry-run",
        "release:publish": "changeset publish"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.3.14",
        "@changesets/cli": "^2.31.0",
        "rimraf": "^6.0.1",
        "typescript": "^5.1.3"
    }
}
