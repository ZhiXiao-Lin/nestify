{
    "name": "@a3s-lab/rustfs",
    "version": "0.0.1",
    "description": "NestJS module for RustFS S3-compatible storage - object storage with bucket and file operations",
    "author": "A3S Lab",
    "license": "MIT",
    "homepage": "https://github.com/A3S-Lab/nestify/tree/main/packages/rustfs#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/A3S-Lab/nestify.git",
        "directory": "packages/rustfs"
    },
    "bugs": {
        "url": "https://github.com/A3S-Lab/nestify/issues"
    },
    "keywords": [
        "nestjs",
        "rustfs",
        "s3",
        "storage",
        "object-storage",
        "bucket"
    ],
    "source": "./src/index.ts",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "README.md",
        "dist/**/*.js",
        "dist/**/*.d.ts",
        "dist/**/*.js.map",
        "!dist/**/__tests__/**",
        "!dist/**/*.spec.*",
        "!dist/**/*.tsbuildinfo"
    ],
    "scripts": {
        "build": "rimraf dist tsconfig.tsbuildinfo && tsc",
        "test": "jest --passWithNoTests",
        "test:cov": "jest --coverage",
        "clean": "rimraf dist && rimraf node_modules",
        "prepublishOnly": "pnpm run build"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1091.0",
        "@aws-sdk/s3-presigned-post": "^3.1091.0",
        "@aws-sdk/s3-request-presigner": "^3.1091.0"
    },
    "devDependencies": {
        "@nestjs/common": "^11.1.28",
        "@types/jest": "^29.5.0",
        "@types/node": "^20.0.0",
        "jest": "^29.5.0",
        "reflect-metadata": "^0.1.13",
        "rimraf": "^6.0.1",
        "ts-jest": "^29.1.0",
        "typescript": "^5.1.3"
    },
    "peerDependencies": {
        "@nestjs/common": "^10.0.0 || ^11.0.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s",
            "!**/__tests__/**"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
