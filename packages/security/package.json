{
    "name": "@a3s-lab/security",
    "version": "0.1.0",
    "description": "Reusable security decorators, guards, and validation helpers for NestJS APIs",
    "author": "A3S Lab",
    "license": "MIT",
    "homepage": "https://github.com/A3S-Lab/nestify/tree/main/packages/security#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/A3S-Lab/nestify.git",
        "directory": "packages/security"
    },
    "bugs": {
        "url": "https://github.com/A3S-Lab/nestify/issues"
    },
    "keywords": [
        "nestjs",
        "security",
        "guards",
        "auth",
        "decorators",
        "path-validation",
        "typescript"
    ],
    "source": "./src/index.ts",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "README.md",
        "dist/**/*.js",
        "dist/**/*.d.ts",
        "dist/**/*.js.map",
        "!dist/**/__tests__/**",
        "!dist/**/*.spec.*",
        "!dist/**/*.tsbuildinfo"
    ],
    "scripts": {
        "build": "rimraf dist && tsc",
        "test": "jest --passWithNoTests",
        "clean": "rimraf dist && rimraf node_modules",
        "prepublishOnly": "pnpm run build"
    },
    "peerDependencies": {
        "@nestjs/common": "^10.0.0",
        "@nestjs/core": "^10.0.0",
        "express": "^4.17.0 || ^5.0.0"
    },
    "devDependencies": {
        "@nestjs/common": "^10.0.0",
        "@nestjs/core": "^10.0.0",
        "@types/express": "^4.17.17",
        "@types/jest": "^29.5.0",
        "jest": "^29.5.0",
        "reflect-metadata": "^0.1.13",
        "rimraf": "^6.0.1",
        "ts-jest": "^29.1.0",
        "typescript": "^5.1.3"
    },
    "publishConfig": {
        "access": "public"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "testEnvironment": "node"
    }
}
