{
    "name": "@a3s-lab/ddd",
    "version": "0.1.0",
    "description": "Framework-independent DDD primitives for backend applications",
    "author": "A3S Lab",
    "license": "MIT",
    "source": "./src/index.ts",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "test": "jest --passWithNoTests",
        "clean": "rimraf dist && rimraf node_modules"
    },
    "devDependencies": {
        "@types/jest": "^29.5.0",
        "jest": "^29.5.0",
        "rimraf": "^6.0.1",
        "ts-jest": "^29.1.0",
        "typescript": "^5.1.3"
    },
    "publishConfig": {
        "access": "public"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "testEnvironment": "node"
    }
}
