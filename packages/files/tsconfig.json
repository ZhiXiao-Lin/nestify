{
    "compilerOptions": {
        "module": "Node16",
        "moduleResolution": "Node16",
        "declaration": true,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "allowSyntheticDefaultImports": true,
        "sourceMap": true,
        "incremental": true,
        "isolatedModules": true,
        "strict": true,
        "skipLibCheck": true,
        "outDir": "dist",
        "target": "ES2021",
        "lib": ["ES2021", "DOM", "ES2022.Error"]
    },
    "include": ["src/**/*"],
    "exclude": ["src/**/*.spec.ts", "src/__tests__/**/*"]
}
