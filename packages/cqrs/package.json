{
    "name": "@a3s-lab/cqrs",
    "version": "0.2.0",
    "description": "Deterministic, bounded NestJS CQRS domain-event publishing for DDD-style APIs",
    "author": "A3S Lab",
    "license": "MIT",
    "homepage": "https://github.com/A3S-Lab/nestify/tree/main/packages/cqrs#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/A3S-Lab/nestify.git",
        "directory": "packages/cqrs"
    },
    "bugs": {
        "url": "https://github.com/A3S-Lab/nestify/issues"
    },
    "keywords": [
        "nestjs",
        "cqrs",
        "ddd",
        "domain-events",
        "typescript"
    ],
    "source": "./src/index.ts",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "README.md",
        "dist/**/*.js",
        "dist/**/*.d.ts",
        "dist/**/*.js.map",
        "!dist/**/__tests__/**",
        "!dist/**/*.spec.*",
        "!dist/**/*.tsbuildinfo"
    ],
    "scripts": {
        "build": "rimraf dist && tsc",
        "test": "jest --passWithNoTests",
        "test:cov": "jest --coverage",
        "lint": "biome lint .",
        "format:check": "biome format .",
        "clean": "rimraf dist && rimraf node_modules",
        "prepublishOnly": "pnpm run build"
    },
    "dependencies": {
        "@a3s-lab/ddd": "workspace:*"
    },
    "peerDependencies": {
        "@nestjs/common": "^10.0.0 || ^11.0.0",
        "@nestjs/cqrs": "^10.0.0 || ^11.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.3.14",
        "@nestjs/common": "^11.1.28",
        "@nestjs/cqrs": "^11.0.3",
        "@nestjs/testing": "^11.1.28",
        "@types/jest": "^29.5.0",
        "jest": "^29.5.0",
        "reflect-metadata": "^0.1.13",
        "rimraf": "^6.0.1",
        "ts-jest": "^29.1.0",
        "typescript": "^5.1.3"
    },
    "publishConfig": {
        "access": "public"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s",
            "!**/__tests__/**",
            "!coverage/**"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
