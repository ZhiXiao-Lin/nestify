{
    "name": "@a3s-lab/http",
    "version": "0.2.0",
    "description": "HTTP API contracts, envelopes, validation, errors, and OpenAPI helpers for NestJS",
    "author": "A3S Lab",
    "license": "MIT",
    "homepage": "https://github.com/A3S-Lab/nestify/tree/main/packages/http#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/A3S-Lab/nestify.git",
        "directory": "packages/http"
    },
    "bugs": {
        "url": "https://github.com/A3S-Lab/nestify/issues"
    },
    "keywords": [
        "nestjs",
        "http",
        "api",
        "openapi",
        "validation",
        "errors",
        "pagination",
        "typescript"
    ],
    "source": "./src/index.ts",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "README.md",
        "dist/**/*.js",
        "dist/**/*.d.ts",
        "dist/**/*.js.map",
        "!dist/**/__tests__/**",
        "!dist/**/*.spec.*",
        "!dist/**/*.tsbuildinfo"
    ],
    "scripts": {
        "build": "rimraf dist && tsc",
        "test": "jest --passWithNoTests",
        "clean": "rimraf dist && rimraf node_modules",
        "prepublishOnly": "pnpm run build"
    },
    "dependencies": {
        "@a3s-lab/ddd": "workspace:*"
    },
    "peerDependencies": {
        "@nestjs/common": "^10.0.0 || ^11.0.0",
        "@nestjs/core": "^10.0.0 || ^11.0.0",
        "@nestjs/swagger": "^7.0.0 || ^11.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.0",
        "express": "^4.17.0 || ^5.0.0",
        "rxjs": "^7.8.0"
    },
    "devDependencies": {
        "@nestjs/common": "^11.1.28",
        "@nestjs/core": "^11.1.28",
        "@nestjs/swagger": "^11.4.6",
        "@types/express": "^5.0.6",
        "@types/jest": "^29.5.0",
        "@types/node": "^20.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.0",
        "express": "^5.2.1",
        "jest": "^29.5.0",
        "reflect-metadata": "^0.1.13",
        "rimraf": "^6.0.1",
        "rxjs": "^7.8.1",
        "ts-jest": "^29.1.0",
        "typescript": "^5.1.3"
    },
    "publishConfig": {
        "access": "public"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "testEnvironment": "node"
    }
}
